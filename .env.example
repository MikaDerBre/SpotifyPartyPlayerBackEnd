# Spotify App Credentials aus dem Spotify Developer Dashboard:
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Diese Redirect-URI muss EXAKT so auch im Spotify Dashboard unter "Redirect URIs" eingetragen sein:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Frontend URL (Standard Quasar Dev Server Port ist 9000):
FRONTEND_URL=http://localhost:9000

# Backend Port:
PORT=3000
